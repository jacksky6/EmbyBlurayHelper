<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EmbyBlurayHelper.Plugin</AssemblyName>
    <Version>0.1.7</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Web/update.html" LogicalName="EmbyBlurayHelper.Plugin.update.html" />
    <EmbeddedResource Include="Web/update.js" LogicalName="EmbyBlurayHelper.Plugin.update.js" />
    <Compile Include="../EmbyBlurayHelper.ProbeWrapper/MediaFeatures/MediaFeatureReceipt.cs" Link="MediaFeatures/MediaFeatureReceipt.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(EmbyInstallPath)\MediaBrowser.Controller.dll')">
    <Reference Include="MediaBrowser.Common" HintPath="$(EmbyInstallPath)\MediaBrowser.Common.dll" Private="false" />
    <Reference Include="MediaBrowser.Controller" HintPath="$(EmbyInstallPath)\MediaBrowser.Controller.dll" Private="false" />
    <Reference Include="MediaBrowser.Model" HintPath="$(EmbyInstallPath)\MediaBrowser.Model.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(EmbyInstallPath)\MediaBrowser.Controller.dll')">
    <PackageReference Include="mediabrowser.server.core" Version="4.9.1.90" />
  </ItemGroup>
</Project>
